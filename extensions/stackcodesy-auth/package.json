{
	"name": "stackcodesy-auth",
	"displayName": "StackCodeSy Authentication",
	"description": "Authentication provider for StackCodeSy platform",
	"version": "1.0.0",
	"publisher": "stackcodesy",
	"engines": {
		"vscode": "^1.107.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
		"onAuthenticationRequest:stackcodesy"
	],
	"contributes": {
		"authentication": [
			{
				"id": "stackcodesy",
				"label": "StackCodeSy"
			}
		]
	},
	"main": "./out/extension.js",
	"scripts": {
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./"
	},
	"devDependencies": {
		"@types/node": "^20.x",
		"@types/vscode": "^1.107.0",
		"typescript": "^5.3.0"
	}
}
