# StackCodeSy Environment Variables Example
# Copy this file to .env and fill in your values

# Server Configuration
HOST=0.0.0.0
PORT=8080
NODE_ENV=production

# ================================
# Security Controls
# ================================

# Authentication Control
# Set to 'true' to ENABLE authentication (production mode)
# Set to 'false' or leave unset to DISABLE authentication (development/testing)
STACKCODESY_REQUIRE_AUTH=false

# ================================
# Terminal Security Control
# ================================
# STACKCODESY_TERMINAL_MODE: Controls terminal access level
#   - "disabled" or "false": No terminal access (maximum security)
#   - "restricted": Limited terminal with command whitelist (RECOMMENDED for production)
#   - "full" or "true": Full terminal access (development only)
STACKCODESY_TERMINAL_MODE=full

# ================================
# Restricted Terminal Configuration
# (only applies when STACKCODESY_TERMINAL_MODE=restricted)
# ================================

# Workspace Directory Restriction
# Set to 'true' to restrict users to workspace directory only (cannot cd outside)
STACKCODESY_TERMINAL_WORKSPACE_ONLY=true

# Workspace Directory Path
# The directory users are restricted to
STACKCODESY_WORKSPACE_DIR=/workspace

# Allowed Commands (comma-separated list)
# Only these commands can be executed in restricted mode
# Examples: npm,yarn,node,git,python,make,cargo,go
STACKCODESY_TERMINAL_ALLOWED_COMMANDS=npm,yarn,pnpm,node,git,python,python3,pip,make,gcc,cargo,go

# Blocked Commands (comma-separated list of dangerous patterns)
# These commands/patterns are always blocked regardless of allowed list
STACKCODESY_TERMINAL_BLOCKED_COMMANDS=rm -rf,dd,mkfs,chmod 777,sudo,wget,curl,ssh

# Block Network Access from Terminal
# Set to 'true' to block network commands (wget, curl, etc.)
STACKCODESY_TERMINAL_BLOCK_NETWORK=false

# Maximum Command Length (prevents excessively long commands)
STACKCODESY_TERMINAL_MAX_COMMAND_LENGTH=1000

# ================================
# StackCodeSy Authentication - Method 1: Direct Variables
# ================================
# Use this for testing or simple deployments
# Only used when STACKCODESY_REQUIRE_AUTH=true
STACKCODESY_USER_ID=
STACKCODESY_USER_NAME=
STACKCODESY_USER_EMAIL=
STACKCODESY_AUTH_TOKEN=

# ================================
# StackCodeSy Authentication - Method 2: API Endpoint
# ================================
# Use this for production deployments
# Your platform should expose this endpoint to validate user sessions
# Only used when STACKCODESY_REQUIRE_AUTH=true
STACKCODESY_AUTH_API=

# ================================
# Example Configurations
# ================================

# Example 1: Development mode (no authentication)
# STACKCODESY_REQUIRE_AUTH=false

# Example 2: Testing with mock user
# STACKCODESY_REQUIRE_AUTH=true
# STACKCODESY_USER_ID=12345
# STACKCODESY_USER_NAME=John Doe
# STACKCODESY_USER_EMAIL=john@example.com
# STACKCODESY_AUTH_TOKEN=your-secure-token-here

# Example 3: Production with API authentication
# STACKCODESY_REQUIRE_AUTH=true
# STACKCODESY_AUTH_API=https://yourplatform.com/api/stackcodesy/auth

# Example 4: Maximum Security (Production with untrusted users - Terminals DISABLED)
# STACKCODESY_REQUIRE_AUTH=true
# STACKCODESY_TERMINAL_MODE=disabled
# STACKCODESY_AUTH_API=https://yourplatform.com/api/stackcodesy/auth

# Example 5: Balanced Security (Production with RESTRICTED terminals)
# STACKCODESY_REQUIRE_AUTH=true
# STACKCODESY_TERMINAL_MODE=restricted
# STACKCODESY_TERMINAL_WORKSPACE_ONLY=true
# STACKCODESY_TERMINAL_ALLOWED_COMMANDS=npm,yarn,node,git,python,make
# STACKCODESY_TERMINAL_BLOCKED_COMMANDS=rm -rf,sudo,wget,curl
# STACKCODESY_AUTH_API=https://yourplatform.com/api/stackcodesy/auth

# ================================
# Extension Marketplace Security
# ================================
# STACKCODESY_EXTENSION_MODE: Controls extension marketplace access
#   - "disabled" or "false": No extension installation allowed
#   - "whitelist" or "restricted": Only whitelisted extensions allowed (RECOMMENDED)
#   - "full" or "true": Full marketplace access (development only)
STACKCODESY_EXTENSION_MODE=full

# Extension Whitelist (comma-separated list of extension IDs)
# Only used when STACKCODESY_EXTENSION_MODE=whitelist
# Example: ms-python.python,dbaeumer.vscode-eslint,esbenp.prettier-vscode
STACKCODESY_EXTENSION_WHITELIST=

# Extension Whitelist File Path
# Alternative to comma-separated list - one extension ID per line
STACKCODESY_EXTENSION_WHITELIST_FILE=/stackcodesy/config/approved-extensions.txt

# ================================
# File System Security
# ================================
# Disk quota in MB (0 = unlimited)
STACKCODESY_DISK_QUOTA_MB=5000

# Maximum file size in MB (0 = unlimited)
STACKCODESY_MAX_FILE_SIZE_MB=100

# Blocked file types (comma-separated extensions)
STACKCODESY_BLOCKED_FILE_TYPES=.exe,.dll,.so.malicious,.sh.malicious

# Enable filesystem monitoring with inotify
STACKCODESY_ENABLE_FILE_MONITORING=false

# Read-only directories (comma-separated paths)
STACKCODESY_READONLY_DIRS=

# ================================
# Network Security
# ================================
# Enable egress filtering (requires CAP_NET_ADMIN)
STACKCODESY_ENABLE_EGRESS_FILTER=false

# Block all outbound traffic except allowed ports
STACKCODESY_BLOCK_ALL_OUTBOUND=false

# Allowed outbound ports (comma-separated)
STACKCODESY_ALLOWED_PORTS=80,443

# Allowed domains (comma-separated, supports wildcards)
# Example: github.com,*.npmjs.org,registry.yarnpkg.com
STACKCODESY_ALLOWED_DOMAINS=

# Enable DNS filtering
STACKCODESY_ENABLE_DNS_FILTER=false

# ================================
# Audit Logging
# ================================
# Enable comprehensive audit logging
STACKCODESY_ENABLE_AUDIT_LOG=true

# Audit log directory
STACKCODESY_AUDIT_LOG_DIR=/var/log/stackcodesy

# Log retention in days
STACKCODESY_AUDIT_LOG_RETENTION_DAYS=30

# Log terminal commands
STACKCODESY_LOG_TERMINAL_COMMANDS=true

# Log file access operations
STACKCODESY_LOG_FILE_ACCESS=false

# Log authentication events
STACKCODESY_LOG_AUTH_EVENTS=true

# ================================
# Content Security Policy
# ================================
# Enable CSP headers
STACKCODESY_ENABLE_CSP=true

# CSP policy level: strict, moderate, relaxed
STACKCODESY_CSP_POLICY=relaxed

# ================================
# Example: Maximum Security Configuration
# ================================
# STACKCODESY_REQUIRE_AUTH=true
# STACKCODESY_TERMINAL_MODE=disabled
# STACKCODESY_EXTENSION_MODE=disabled
# STACKCODESY_ENABLE_EGRESS_FILTER=true
# STACKCODESY_BLOCK_ALL_OUTBOUND=true
# STACKCODESY_DISK_QUOTA_MB=1000
# STACKCODESY_ENABLE_AUDIT_LOG=true
# STACKCODESY_AUTH_API=https://yourplatform.com/api/auth

# ================================
# Example: Whitelist-Based Security (RECOMMENDED for Production)
# ================================
# STACKCODESY_REQUIRE_AUTH=true
# STACKCODESY_TERMINAL_MODE=restricted
# STACKCODESY_TERMINAL_WORKSPACE_ONLY=true
# STACKCODESY_TERMINAL_ALLOWED_COMMANDS=npm,yarn,node,git,python,make
# STACKCODESY_EXTENSION_MODE=whitelist
# STACKCODESY_EXTENSION_WHITELIST=ms-python.python,dbaeumer.vscode-eslint,esbenp.prettier-vscode
# STACKCODESY_DISK_QUOTA_MB=3000
# STACKCODESY_ENABLE_AUDIT_LOG=true
# STACKCODESY_ENABLE_CSP=true
# STACKCODESY_CSP_POLICY=moderate
# STACKCODESY_AUTH_API=https://yourplatform.com/api/auth
