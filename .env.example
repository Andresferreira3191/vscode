# StackCodeSy Environment Variables Example
# Copy this file to .env and fill in your values

# Server Configuration
HOST=0.0.0.0
PORT=8080
NODE_ENV=production

# ================================
# Authentication Control
# ================================
# Set to 'true' to ENABLE authentication (production mode)
# Set to 'false' or leave unset to DISABLE authentication (development/testing)
STACKCODESY_REQUIRE_AUTH=false

# ================================
# StackCodeSy Authentication - Method 1: Direct Variables
# ================================
# Use this for testing or simple deployments
# Only used when STACKCODESY_REQUIRE_AUTH=true
STACKCODESY_USER_ID=
STACKCODESY_USER_NAME=
STACKCODESY_USER_EMAIL=
STACKCODESY_AUTH_TOKEN=

# ================================
# StackCodeSy Authentication - Method 2: API Endpoint
# ================================
# Use this for production deployments
# Your platform should expose this endpoint to validate user sessions
# Only used when STACKCODESY_REQUIRE_AUTH=true
STACKCODESY_AUTH_API=

# ================================
# Example Configurations
# ================================

# Example 1: Development mode (no authentication)
# STACKCODESY_REQUIRE_AUTH=false

# Example 2: Testing with mock user
# STACKCODESY_REQUIRE_AUTH=true
# STACKCODESY_USER_ID=12345
# STACKCODESY_USER_NAME=John Doe
# STACKCODESY_USER_EMAIL=john@example.com
# STACKCODESY_AUTH_TOKEN=your-secure-token-here

# Example 3: Production with API authentication
# STACKCODESY_REQUIRE_AUTH=true
# STACKCODESY_AUTH_API=https://yourplatform.com/api/stackcodesy/auth
