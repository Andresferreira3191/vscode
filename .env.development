# ================================
# StackCodeSy - Development Mode
# Full access, no restrictions
# ================================

# Server Configuration
STACKCODESY_HOST=0.0.0.0
STACKCODESY_PORT=8080
NODE_ENV=development

# ================================
# Authentication: DISABLED
# ================================
STACKCODESY_REQUIRE_AUTH=false

# ================================
# Terminal: FULL ACCESS
# ================================
STACKCODESY_TERMINAL_MODE=full

# ================================
# Extensions: FULL ACCESS
# ================================
STACKCODESY_EXTENSION_MODE=full

# ================================
# File System: NO RESTRICTIONS
# ================================
STACKCODESY_DISK_QUOTA_MB=0
STACKCODESY_MAX_FILE_SIZE_MB=1000
STACKCODESY_BLOCKED_FILE_TYPES=
STACKCODESY_ENABLE_FILE_MONITORING=false
STACKCODESY_READONLY_DIRS=

# ================================
# Network: NO RESTRICTIONS
# ================================
STACKCODESY_ENABLE_EGRESS_FILTER=false
STACKCODESY_BLOCK_ALL_OUTBOUND=false
STACKCODESY_ALLOWED_PORTS=
STACKCODESY_ALLOWED_DOMAINS=
STACKCODESY_ENABLE_DNS_FILTER=false

# ================================
# Audit Logging: MINIMAL
# ================================
STACKCODESY_ENABLE_AUDIT_LOG=false
STACKCODESY_LOG_TERMINAL_COMMANDS=false
STACKCODESY_LOG_FILE_ACCESS=false
STACKCODESY_LOG_AUTH_EVENTS=false

# ================================
# Content Security Policy: RELAXED
# ================================
STACKCODESY_ENABLE_CSP=false
STACKCODESY_CSP_POLICY=relaxed
