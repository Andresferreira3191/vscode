# ================================
# StackCodeSy - Production Mode
# Maximum security restrictions
# ================================

# Server Configuration
STACKCODESY_HOST=0.0.0.0
STACKCODESY_PORT=8080
NODE_ENV=production

# ================================
# Authentication: ENABLED
# ================================
STACKCODESY_REQUIRE_AUTH=true

# Method 1: Direct credentials (for testing)
# STACKCODESY_USER_ID=user123
# STACKCODESY_USER_NAME=John Doe
# STACKCODESY_USER_EMAIL=john@example.com
# STACKCODESY_AUTH_TOKEN=your-secure-token-here

# Method 2: API endpoint (recommended)
STACKCODESY_AUTH_API=https://your-platform.com/api/auth/validate

# ================================
# Terminal: RESTRICTED MODE
# ================================
STACKCODESY_TERMINAL_MODE=restricted
STACKCODESY_TERMINAL_WORKSPACE_ONLY=true
STACKCODESY_WORKSPACE_DIR=/workspace
STACKCODESY_TERMINAL_ALLOWED_COMMANDS=npm,yarn,pnpm,node,git,python,python3,pip,make,go
STACKCODESY_TERMINAL_BLOCKED_COMMANDS=rm -rf,dd,mkfs,sudo,su,wget,curl,nc,ssh
STACKCODESY_TERMINAL_BLOCK_NETWORK=true
STACKCODESY_TERMINAL_MAX_COMMAND_LENGTH=1000

# ================================
# Extensions: WHITELIST MODE
# ================================
STACKCODESY_EXTENSION_MODE=whitelist
STACKCODESY_EXTENSION_WHITELIST=ms-python.python,dbaeumer.vscode-eslint,esbenp.prettier-vscode
STACKCODESY_EXTENSION_WHITELIST_FILE=/stackcodesy/config/approved-extensions.txt

# ================================
# File System: RESTRICTED
# ================================
STACKCODESY_DISK_QUOTA_MB=5000
STACKCODESY_MAX_FILE_SIZE_MB=100
STACKCODESY_BLOCKED_FILE_TYPES=.exe,.dll,.so,.bin
STACKCODESY_ENABLE_FILE_MONITORING=true
STACKCODESY_READONLY_DIRS=/stackcodesy,/usr,/bin,/sbin

# ================================
# Network: RESTRICTED
# ================================
STACKCODESY_ENABLE_EGRESS_FILTER=true
STACKCODESY_BLOCK_ALL_OUTBOUND=false
STACKCODESY_ALLOWED_PORTS=80,443
STACKCODESY_ALLOWED_DOMAINS=npmjs.org,github.com,registry.npmjs.org
STACKCODESY_ENABLE_DNS_FILTER=true

# ================================
# Audit Logging: FULL
# ================================
STACKCODESY_ENABLE_AUDIT_LOG=true
STACKCODESY_AUDIT_LOG_DIR=/var/log/stackcodesy
STACKCODESY_AUDIT_LOG_RETENTION_DAYS=30
STACKCODESY_LOG_TERMINAL_COMMANDS=true
STACKCODESY_LOG_FILE_ACCESS=true
STACKCODESY_LOG_AUTH_EVENTS=true

# ================================
# Content Security Policy: STRICT
# ================================
STACKCODESY_ENABLE_CSP=true
STACKCODESY_CSP_POLICY=strict
